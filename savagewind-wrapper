#!/bin/sh
# Wrapper for Savage Wind inside Flatpak.
#
# 上游 AppImage 的入口只有一行 exec usr/bin/savagewind，真正的逻辑都在二进制里：
# 它按 $XDG_DATA_HOME/savagewind 定位数据目录，再调用同级的 zig/ 与 swgen/ 在本机
# 重新编译游戏代码。这里只做 Flatpak 需要的环境兜底，不做路径改写。

set -eu

APP_BIN=/app/bin
APP_LIB=/app/lib

# ---- CJK 字体 ----
# 上游把 CJK 回退字体的候选路径写死在 /usr/share/fonts/...（二进制里的
# ui_merge_fallback_font / zh_hans_fonts），而 Flatpak 沙箱下：
#   * /usr 是只读的，不能在运行时写入；
#   * /app/share/fonts 只会被 fontconfig 收录（50-flatpak.conf），
#     不会出现在 /usr/share/fonts；
#   * --filesystem 只能映射到 /run/host/...。
# 所以那几条硬编码路径在沙箱里永远打不开。改走上游提供的三个环境变量：
#   * SAVAGEWIND_FONT        -> 游戏内文本（HUD/对话/菜单，走 nn::pl 系统共享字体）
#   * SAVAGEWIND_MENU_FONT   -> 游戏内叠加菜单（ImGui）
#   * SAVAGEWIND_LAUNCHER_FONT -> 启动器 / Configuration 窗口（ImGui）
#
# 关键：两类用途需要不同轮廓格式的字体。
#   游戏字体引擎（nn::font/nn::pl 路径）只能读 TrueType(glyf) 轮廓，遇到 CFF(.otf) 会崩溃
#   （上游 runtime/hle/pl.c 的注释与 docs/linux.md 都写了这一点）。所以游戏内文本必须用
#   文泉驿微米黑（TrueType，含简繁日韩）；ImGui（stb_truetype）可以读 CFF，用 Noto Sans SC。
SAVAGEWIND_NOTO_FONT=/app/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc
SAVAGEWIND_WQY_FONT=/app/share/fonts/wqy/wqy-microhei.ttc

# ImGui 界面：Noto Sans SC（字形更好看，stb_truetype 能解 CFF）
for _f in "${SAVAGEWIND_NOTO_FONT}" "${SAVAGEWIND_WQY_FONT}"; do
    if [ -r "${_f}" ]; then
        : "${SAVAGEWIND_MENU_FONT:=$_f}"
        : "${SAVAGEWIND_LAUNCHER_FONT:=$_f}"
        break
    fi
done
export SAVAGEWIND_MENU_FONT SAVAGEWIND_LAUNCHER_FONT

# 游戏内文本：文泉驿微米黑（TrueType）。绝不能用 .otf：游戏字体引擎遇到 CFF 会崩溃。
if [ -r "${SAVAGEWIND_WQY_FONT}" ]; then
    : "${SAVAGEWIND_FONT:=${SAVAGEWIND_WQY_FONT}}"
    export SAVAGEWIND_FONT
else
    echo "savagewind-wrapper: 缺少游戏内中文字体：${SAVAGEWIND_WQY_FONT}" >&2
    echo "savagewind-wrapper: 游戏内中文会显示为乱码/日文字形" >&2
fi

if [ ! -r "${SAVAGEWIND_NOTO_FONT}" ] && [ ! -r "${SAVAGEWIND_WQY_FONT}" ]; then
    echo "savagewind-wrapper: 缺少 CJK 界面字体" >&2
    echo "savagewind-wrapper: 中文界面会显示为方块/问号" >&2
fi

# 沙箱内 runtime 只带 C.UTF-8，没有 zh_CN locale 数据，强行设 zh_CN.UTF-8 会让
# setlocale 失败。界面文本本身是 UTF-8，C.UTF-8 即可正常显示中文。
: "${LANG:=C.UTF-8}"
: "${LC_ALL:=C.UTF-8}"
export LANG LC_ALL

# Flatpak 中 XDG 路径由 runtime 注入：
#   XDG_DATA_HOME -> ~/.var/app/<id>/data
# Savage Wind 的 log / ini / save / 已编译的游戏库都落在 ${XDG_DATA_HOME}/savagewind。
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
SAVAGEWIND_DATA_DIR="${XDG_DATA_HOME}/savagewind"
mkdir -p "${SAVAGEWIND_DATA_DIR}"

# 兜底：确保运行时能按 RUNPATH($ORIGIN/../lib) 之外的顺序找到私有库
# （正常情况下 RUNPATH 已足够，这里只是防止宿主/运行时混装 SDL3、ffmpeg）
LD_LIBRARY_PATH="${APP_LIB}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH

# zig 与 swgen 以子进程方式被调用，显式写进 PATH，避免首次 setup 时找不到工具链
PATH="${APP_BIN}:${APP_BIN}/zig:${PATH}"
export PATH

# zig 首次编译会写全局缓存，固定到沙箱可写区（默认值落在 $HOME/.cache，同样可行，
# 但显式指定可避免 $HOME 只读的重度沙箱环境）
: "${ZIG_GLOBAL_CACHE_DIR:=${XDG_CACHE_HOME:-${HOME}/.cache}/zig}"
export ZIG_GLOBAL_CACHE_DIR
mkdir -p "${ZIG_GLOBAL_CACHE_DIR}"

# 游戏在 setup 阶段会并行编译游戏代码，沙箱内 /tmp 是私有 tmpfs，
# 大工程临时文件建议落到数据目录，避免 tmpfs 内存压力
: "${TMPDIR:=${SAVAGEWIND_DATA_DIR}/.tmp}"
export TMPDIR
mkdir -p "${TMPDIR}"

# 未显式指定 GPU 时交给上游自动选择（离散优先），这里不做覆盖

# 固定工作目录到可持久化数据目录，避免相对路径写入落进只读的 /app
cd "${SAVAGEWIND_DATA_DIR}"

exec "${APP_BIN}/savagewind" "$@"
